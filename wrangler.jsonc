{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madeinguangdong-com",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-06-21",
  "assets": {
    "directory": "dist-cloudflare",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/chanpin-madeinguangdong.html"
    ]
  },
  "observability": {
    "enabled": true
  }
}
